---
const { user } = Astro.locals;
---

<header class="border-border bg-card border-b">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 text-sm sm:px-6">
    {
      user ? (
        <>
          <span class="text-muted-foreground">{user.email}</span>
          <nav class="flex items-center gap-4">
            <a href="/dashboard" class="text-primary rounded-sm transition-colors hover:underline">
              Dashboard
            </a>
            <form method="POST" action="/api/auth/signout">
              <button type="submit" class="text-primary rounded-sm transition-colors hover:underline">
                Sign out
              </button>
            </form>
          </nav>
        </>
      ) : (
        <>
          <span class="text-muted-foreground">Not signed in</span>
          <nav class="flex items-center gap-4">
            <a href="/auth/signin" class="text-primary rounded-sm transition-colors hover:underline">
              Sign in
            </a>
            <a href="/auth/signup" class="text-primary rounded-sm transition-colors hover:underline">
              Sign up
            </a>
          </nav>
        </>
      )
    }
  </div>
</header>
