---
const { user } = Astro.locals;

const navLinks = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/medications", label: "Medications" },
  { href: "/specialists", label: "Specialists" },
  { href: "/visits", label: "Visits" },
];

const path = Astro.url.pathname;

// "Active" is carried by an underline and `aria-current`, not by colour alone —
// every link in this bar is already green.
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-border bg-card border-b">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 text-sm sm:px-6">
    {
      user ? (
        <>
          <span class="text-muted-foreground">{user.email}</span>
          <nav class="flex items-center gap-4">
            {navLinks.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class:list={[
                  "text-primary rounded-sm border-b-2 pb-0.5 transition-colors hover:underline",
                  isActive(href) ? "border-primary font-semibold" : "border-transparent",
                ]}
              >
                {label}
              </a>
            ))}
            <form method="POST" action="/api/auth/signout">
              <button type="submit" class="text-primary rounded-sm transition-colors hover:underline">
                Sign out
              </button>
            </form>
          </nav>
        </>
      ) : (
        <>
          <span class="text-muted-foreground">Not signed in</span>
          <nav class="flex items-center gap-4">
            <a href="/auth/signin" class="text-primary rounded-sm transition-colors hover:underline">
              Sign in
            </a>
            <a href="/auth/signup" class="text-primary rounded-sm transition-colors hover:underline">
              Sign up
            </a>
          </nav>
        </>
      )
    }
  </div>
</header>
