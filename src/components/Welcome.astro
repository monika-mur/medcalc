---
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
---

<div class="bg-background flex min-h-screen flex-col">
  <Topbar />

  <main
    class="mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center px-4 py-20 text-center sm:px-6"
  >
    <h1 class="text-foreground text-4xl font-bold tracking-tight sm:text-5xl">MedCalc</h1>
    <p class="text-muted-foreground mt-4 max-w-xl text-lg">
      Track your medications and know when your supply runs out — before it does.
    </p>
    <div class="mt-10 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="/auth/signin" class:list={buttonVariants({ size: "lg" })}>Sign in</a>
      <a href="/auth/signup" class:list={buttonVariants({ variant: "outline", size: "lg" })}>Sign up</a>
    </div>
  </main>
</div>
