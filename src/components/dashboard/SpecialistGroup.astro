---
import SupplyCard from "@/components/dashboard/SupplyCard.astro";
import type { SpecialistGroup } from "@/lib/dashboard";

interface Props {
  group: SpecialistGroup;
}

const { group } = Astro.props;
---

<section aria-labelledby={`specialist-${group.specialist.id}`}>
  <div class="flex flex-col gap-x-4 gap-y-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h2 id={`specialist-${group.specialist.id}`} class="text-foreground text-lg font-semibold break-words">
      {group.specialist.name}
      {
        group.specialist.specialty ? (
          <span class="text-muted-foreground font-normal"> · {group.specialist.specialty}</span>
        ) : null
      }
    </h2>

    <p class="text-muted-foreground text-sm">
      {
        group.nextVisitDate ? (
          <>
            Next visit {/* The stored string, unformatted — see `SupplyCard.astro`. */}
            <time datetime={group.nextVisitDate} class="text-foreground font-medium">
              {group.nextVisitDate}
            </time>
          </>
        ) : (
          "No visit scheduled"
        )
      }
    </p>
  </div>

  <ul class="mt-3 space-y-3">
    {group.cards.map((card) => <SupplyCard medication={card.medication} state={card.state} />)}
  </ul>
</section>
