---
import type { CardState } from "@/lib/dashboard";
import { nextNonzeroPendingChange, type MedicationView } from "@/lib/db/medications";

interface Props {
  medication: MedicationView;
  state: CardState;
}

const { medication, state } = Astro.props;

/*
  The word carries the status; colour is the redundant cue, never the only one —
  the same contract `MedicationsManager`'s `STATUS_LABEL` keeps, and the same
  reason `Topbar.astro:13-15` pairs `aria-current` with an underline.
*/
const STATE_LABEL: Record<CardState, string> = {
  no_dosage: "No dosage recorded",
  out_of_stock: "Out of stock",
  red: "Order now",
  yellow: "Tight",
  green: "Enough",
  no_visit: "No visit scheduled",
  stopped: "Stopped",
};

/*
  Coloured text, not a filled pill. This screen renders one badge per medication,
  and `CLAUDE.md` -> _Design conventions_ is explicit that a screen where green
  is a background is a screen where green has stopped meaning anything. A badge
  needing more weight gets size or font weight, never a background.

  Every value is a `:root` token — `text-warning` is the amber one S-04 added,
  whose shade is argued in `global.css`. Never a hardcoded palette class here.
*/
const STATE_CLASS: Record<CardState, string> = {
  no_dosage: "text-destructive",
  out_of_stock: "text-destructive",
  red: "text-destructive",
  yellow: "text-warning",
  green: "text-primary",
  no_visit: "text-muted-foreground",
  stopped: "text-muted-foreground",
};

/*
  A `no_dosage` card shows no supply-end date and no quantity, because both would
  be fabrications: there is no `dosage_changes` row, so nothing about this
  medication's supply can be calculated. It is the only card that tells the user
  to do something to the app rather than about their medication.
*/
const isUnknowable = state === "no_dosage";

/*
  The soonest scheduled change, or `undefined`. `pending_dosage_changes` is
  ascending and is the only copy of this — read the head rather than adding a
  second field for it.

  `.at(0)`, not `[0]`: indexed access is not checked under this tsconfig, so
  `[0]` types as present and every guard on it reads to the linter as
  always-truthy. `.at()` returns `T | undefined` and tells the truth — the same
  reason `@/lib/db/medications` reaches for `data.at(0)` and `removed.at(0)`.
*/
const nextChange = medication.pending_dosage_changes.at(0);

/*
  The `not_started` reason names the day the DOSAGE actually begins, which is
  not necessarily `nextChange`: if the soonest pending row is itself 0/day,
  pointing the reason at it would name a stop date and call it a start. The rule
  is shared with `deriveStatus`'s trigger and the medications-list label rather
  than re-derived here — see `nextNonzeroPendingChange`.
*/
const nextNonzeroChange = nextNonzeroPendingChange(medication.pending_dosage_changes);

/*
  `not_started` is tested on `medication.status`, NOT on `state`: it has no card
  state of its own by deliberate decision, so it arrives here carrying whatever
  band `classifySupplyStatus` earned it. That is the point — the colour still
  says whether to act, and only the wording changes.

  It must never fall to the `stopped` branch below. Before S-05 it did, and the
  card read "Dosage is set to 0, so nothing is being consumed" for a medication
  that simply starts next week — the defect S-04 handed over.
*/
const reason = isUnknowable
  ? "No daily dosage has been recorded, so supply cannot be calculated."
  : medication.status === "not_started" && nextNonzeroChange
    ? `Dosage begins on ${nextNonzeroChange.effective_date}.`
    : state === "stopped"
      ? "Dosage is set to 0, so nothing is being consumed."
      : medication.supply_end_reason === "expiry"
        ? "Limited by the printed expiry date, not by how fast it is used."
        : medication.supply_end_date === null
          ? "No supply has ever been recorded."
          : "Based on the recorded doses and refills.";
---

<li class="border-border bg-card rounded-xl border p-4 shadow-sm">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="text-foreground font-medium break-words">{medication.name}</p>

      {
        isUnknowable ? null : (
          <p class="text-muted-foreground mt-1 text-sm">
            {medication.supply_end_date ? (
              <>
                Lasts until{" "}
                {/* Rendered as the stored `YYYY-MM-DD` string. Formatting it
                    would mean parsing it into a `Date`, which is how this
                    screen would acquire an off-by-one-day bug. */}
                <time datetime={medication.supply_end_date} class="text-foreground font-medium">
                  {medication.supply_end_date}
                </time>
              </>
            ) : (
              "No supply-end date"
            )}
          </p>
        )
      }

      <p class="text-muted-foreground mt-1 text-sm">{reason}</p>

      {
        isUnknowable ? (
          <p class="mt-2 text-sm">
            <a href="/medications" class="text-primary rounded-sm font-medium hover:underline">
              Record a dosage
            </a>
          </p>
        ) : (
          <dl class="text-muted-foreground mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            <div class="flex gap-1">
              <dt>On hand:</dt>
              <dd class="text-foreground">{medication.projected_quantity}</dd>
            </div>
            <div class="flex gap-1">
              <dt>Dosage:</dt>
              <dd class="text-foreground">{medication.current_dosage} / day</dd>
            </div>
            {/*
              Only when there is one — no empty row and no "—", because a
              placeholder on every medication without a scheduled change would
              be noise on the majority of cards.

              This is what explains a supply-end date the two figures beside it
              cannot account for: at 1/day with 23 left the date is five weeks
              out, and the only reason it reads as one week is the change named
              here. Without this line the dashboard recalculates correctly and
              silently, which is the half of US-02 that looks like a bug.
            */}
            {nextChange && (
              <div class="flex gap-1">
                <dt>Changes to:</dt>
                <dd class="text-foreground">
                  {nextChange.daily_dosage} / day on{" "}
                  {/* The stored `YYYY-MM-DD` string, unformatted — see the
                      supply-end date above. */}
                  <time datetime={nextChange.effective_date}>{nextChange.effective_date}</time>
                </dd>
              </div>
            )}
          </dl>
        )
      }
    </div>

    <p class="flex flex-wrap items-center gap-2 text-sm font-medium">
      <span class:list={[STATE_CLASS[state]]}>{STATE_LABEL[state]}</span>
      {medication.is_expired ? <span class="text-destructive">Expired</span> : null}
    </p>
  </div>
</li>
